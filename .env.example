POSTGRES_DB=java_basecamp
POSTGRES_USER=java_basecamp
POSTGRES_PASSWORD=change-this-in-production
APP_PORT=3000
DB_PORT=5432
SESSION_DAYS=30
COOKIE_SECURE=false
ENFORCE_HTTPS=false
# Set to the public HTTPS origin when deployed, for example:
# APP_ORIGIN=https://learn.example.com
# PUBLIC_APP_URL=https://learn.example.com
# For production HTTPS, set COOKIE_SECURE=true and ENFORCE_HTTPS=true together.
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true

# Optional lesson-scoped AI guide. Keep this key server-side and never add a real key to Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_DAILY_LIMIT=20
AI_MINUTE_LIMIT=5
AI_GLOBAL_DAILY_LIMIT=200
AI_MAX_OUTPUT_TOKENS=450
AI_CACHE_DAYS=7
AI_TIMEOUT_SECONDS=20
