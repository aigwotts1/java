{
  "name": "java-basecamp",
  "version": "1.0.0",
  "private": true,
  "description": "A friendly Java learning roadmap with account-based progress tracking.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
