    "test:integration": "node --test test/integration.test.js",
    "test:browser": "node test/browser-smoke.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.3"
  }
}
